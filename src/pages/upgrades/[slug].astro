---
import { getCollection } from "astro:content";
import UpgradeEntry from "~/components/reference/UpgradeEntry.astro";
import { getPageCopy } from "~/utils/pages";

export const getStaticPaths = async () => {
	const all = (await getCollection("upgrades")).sort(
		(a, b) => a.data.date.getTime() - b.data.date.getTime(),
	);
	return all.map((entry, i) => ({
		params: { slug: entry.id },
		props: { entry, prev: all[i - 1], next: all[i + 1] },
	}));
};

const copy = await getPageCopy("upgrades-entry");
const { entry, prev, next } = Astro.props;
---

<UpgradeEntry entry={entry} slug={entry.id} prev={prev} next={next} copy={copy} />
