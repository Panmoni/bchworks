---
// /<code>/guides/<slug>: a translated country guide (PAN-388). Only a guide
// with a translation in src/content/guides/<code>/ gets a route. A guide
// written in that language (Venezuela in Spanish) is its own original at
// /guides/<slug> and has none (docs/i18n.md, "Fallback policy").
import { type CollectionEntry, getCollection, render } from "astro:content";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import ArticleShell from "~/components/reference/ArticleShell.astro";
import { DEFAULT_LOCALE, LOCALES } from "~/i18n/locales";
import { m, msg } from "~/i18n/messages";
import { getLocalizedEntry, getTranslationState } from "~/utils/l10n";

export const getStaticPaths = (async () => {
	const guides = await getCollection("guides");
	const paths = [];
	for (const { code } of LOCALES.filter((l) => l.code !== DEFAULT_LOCALE)) {
		for (const guide of guides) {
			// Written in this locale: it is its own original at /guides/<slug>.
			if (guide.data.lang === code) continue;
			const entry = await getLocalizedEntry("guides", guide.id, code);
			if (!entry) continue;
			paths.push({
				params: { locale: code, slug: guide.id },
				props: {
					entry,
					locale: code,
					translation: await getTranslationState("guides", guide.id, code),
				},
			});
		}
	}
	return paths;
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry, locale, translation } = Astro.props as Props;
const { Content } = await render(entry);
// getLocalizedEntry's union leaves data untyped; it is a guide's, minus lang.
const d = entry.data as Omit<CollectionEntry<"guides">["data"], "lang">;
---

<ArticleShell
  title={d.title}
  description={d.description}
  verified={d.verified}
  lang={locale}
  eyebrow={`<a href="/guides">${m.nav_country_guides({}, msg(locale))}</a> · ${d.flag} ${d.country}`}
  faq={d.faq}
  sources={d.sources}
  translation={translation}
>
  <Content />
</ArticleShell>
