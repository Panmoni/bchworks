---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import BlogListPage from "~/components/pages/BlogListPage.astro";
import { getStaticPathsBlogList } from "~/utils/blog";
import { getPageCopy } from "~/utils/pages";

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
	return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const copy = await getPageCopy("blog-page");
---

<BlogListPage page={page} copy={copy} />
