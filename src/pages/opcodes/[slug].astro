---
import { getCollection } from "astro:content";
import OpcodeEntry from "~/components/reference/OpcodeEntry.astro";
import { getPageCopy } from "~/utils/pages";

export const getStaticPaths = async () => {
	const all = (await getCollection("opcodes")).sort(
		(a, b) => a.data.code - b.data.code,
	);
	return all.map((entry, i) => ({
		params: { slug: entry.id },
		props: { entry, prev: all[i - 1], next: all[i + 1] },
	}));
};

const copy = await getPageCopy("opcodes-entry");
const { entry, prev, next } = Astro.props;
---

<OpcodeEntry entry={entry} prev={prev} next={next} copy={copy} />
