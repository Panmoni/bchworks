---
import { getCollection } from "astro:content";
import ArticleShell from "~/components/reference/ArticleShell.astro";
import { isNoindexOpcode } from "~/utils/opcodes.mjs";
import { getPageCopy } from "~/utils/pages";

export const getStaticPaths = async () => {
	const all = (await getCollection("opcodes")).sort(
		(a, b) => a.data.code - b.data.code,
	);
	return all.map((entry, i) => ({
		params: { slug: entry.id },
		props: { entry, prev: all[i - 1], next: all[i + 1] },
	}));
};

const copy = await getPageCopy("opcodes-entry");
const { entry, prev, next } = Astro.props;
const o = entry.data;
const toHex = (n: number) => `0x${n.toString(16).padStart(2, "0")}`;
const hex =
	o.codeEnd === undefined
		? toHex(o.code)
		: `${toHex(o.code)}–${toHex(o.codeEnd)}`;
const btcLabel: Record<string, string> = copy.btcLabel;
const fill = (template: string) =>
	template
		.replaceAll("{name}", () => o.name)
		.replaceAll("{hex}", () => hex)
		.replaceAll("{group}", () => o.group)
		.replaceAll("{status}", () => o.status);
const upgrade = o.since
	? (await getCollection("upgrades")).find((u) => u.id === o.since)
	: undefined;

// Pad short descriptions for search snippets, staying inside ~160 characters.
// Noindex opcodes share long descriptions (the NOPs, the undefined bytes), so
// theirs lead with the name and byte to keep every meta description unique.
const noindex = isNoindexOpcode(o);
const suffix = fill(copy.metadata.description);
const metaDescription =
	o.metaDescription ??
	(o.description.length + suffix.length <= 160
		? o.description + suffix
		: noindex
			? `${o.name} (${hex}): ${o.description}`
			: o.description);
const robots = noindex ? { index: false, follow: true } : undefined;
const kindLabel: Record<string, string> = copy.usedIn.kind;

const term = {
	"@context": "https://schema.org",
	"@type": "DefinedTerm",
	name: o.name,
	termCode: hex,
	description: o.description,
	inDefinedTermSet: "https://bchworks.com/opcodes",
};
---

<ArticleShell
  title={fill(copy.title)}
  description={o.description}
  metaTitle={fill(copy.metadata.title)}
  metaDescription={metaDescription}
  verified={o.verified}
  eyebrow={fill(copy.eyebrow)}
  sources={o.sources}
  robots={robots}
>
  <Fragment slot="before">
    <script type="application/ld+json" set:html={JSON.stringify(term)} />
    <dl class="not-prose grid sm:grid-cols-2 gap-4 mb-8">
      <div class="wb-card p-4">
        <dt class="font-mono text-xs text-muted uppercase">{copy.facts.stack}</dt>
        <dd class="font-mono mt-1">{o.stackIn || '∅'} → {o.stackOut || '∅'}</dd>
      </div>
      <div class="wb-card p-4">
        <dt class="font-mono text-xs text-muted uppercase">{copy.facts.since}</dt>
        <dd class="mt-1">
          {upgrade ? <a class="underline" href={`/upgrades/${upgrade.id}`}>{upgrade.data.title}</a> : (o.sinceNote ?? copy.facts.original)}
        </dd>
      </div>
      {
        o.cost && (
          <div class="wb-card p-4">
            <dt class="font-mono text-xs text-muted uppercase">{copy.facts.cost}</dt>
            <dd class="mt-1">{o.cost}</dd>
          </div>
        )
      }
      <div class="wb-card p-4">
        <dt class="font-mono text-xs text-muted uppercase">{copy.facts.btcStatus}</dt>
        <dd class="mt-1">{btcLabel[o.btc]}{o.btcNote && <span class="block text-sm text-muted mt-1">{o.btcNote}</span>}</dd>
      </div>
      {
        o.aliases.length > 0 && (
          <div class="wb-card p-4">
            <dt class="font-mono text-xs text-muted uppercase">{copy.facts.aliases}</dt>
            <dd class="font-mono mt-1">{o.aliases.join(', ')}</dd>
          </div>
        )
      }
    </dl>
  </Fragment>

  {
    o.example && (
      <>
        <h2>{copy.example.title}</h2>
        <pre><code>{o.example}</code></pre>
        {
          o.walkthrough.length > 0 && (
            <table>
              <thead>
                <tr>
                  <th>{copy.example.step}</th>
                  <th>{copy.example.stack}</th>
                  <th>{copy.example.note}</th>
                </tr>
              </thead>
              <tbody>
                {o.walkthrough.map((s) => (
                  <tr>
                    <td><code>{s.op}</code></td>
                    <td><code>{s.stack}</code></td>
                    <td>{s.note}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )
        }
        <p set:html={copy.example.debugger} />
      </>
    )
  }

  {
    o.usedIn.length > 0 && (
      <>
        <h2>{fill(copy.usedIn.title)}</h2>
        <ul>
          {o.usedIn.map((u) => (
            <li>
              <span class="font-mono text-xs uppercase text-muted">{kindLabel[u.kind]}</span>{" "}
              {u.url.startsWith("/") ? (
                <a href={u.url}>{u.title}</a>
              ) : (
                <a href={u.url} target="_blank" rel="noopener noreferrer">{u.title}</a>
              )}
              : {u.note}
            </li>
          ))}
        </ul>
      </>
    )
  }

  <Fragment slot="after">
    <nav class="mt-10 flex justify-between gap-4 font-mono text-sm">
      {prev ? <a class="underline" href={`/opcodes/${prev.id}`}>← {prev.data.name}</a> : <span />}
      {next && <a class="underline" href={`/opcodes/${next.id}`}>{next.data.name} →</a>}
    </nav>
  </Fragment>
</ArticleShell>
