---
import { getCollection } from "astro:content";
import ChipEntry from "~/components/reference/ChipEntry.astro";
import { getPageCopy } from "~/utils/pages";

export const getStaticPaths = async () =>
	(await getCollection("chips")).map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));

const copy = await getPageCopy("chips-entry");
const { entry } = Astro.props;
---

<ChipEntry entry={entry} copy={copy} />
