---
// The /contact page, English or translated (PAN-387). The routes
// src/pages/contact.astro and src/pages/[locale]/[page].astro pass the copy.
import Features2 from "~/components/widgets/Features2.astro";
import HeroText from "~/components/widgets/HeroText.astro";
import Layout from "~/layouts/PageLayout.astro";
import type { TranslationState } from "~/utils/l10n";
import type { PageCopy } from "~/utils/pages";

interface Props {
	/** The page copy for this locale (src/content/pages/[<locale>/]contact). */
	copy: PageCopy;
	/** Set on a translated page: drives its <TranslationNotice>. */
	translation?: TranslationState | null;
}

const { copy, translation = null } = Astro.props;
const metadata = copy.metadata;
const channels: { title: string; text: string; note: string; href: string }[] =
	copy.channels;
---

<Layout metadata={metadata} translation={translation}>
  <HeroText tagline={copy.hero.tagline} title={copy.hero.title} />

  <section class="max-w-4xl mx-auto px-4 sm:px-6 pb-8">
    <p class="text-xl text-muted mb-6" set:html={copy.intro} />
    <ul class="grid gap-5 sm:grid-cols-2">
      {
        channels.map((c) => (
          <li>
            <a
              class="wb-card wb-card-hover flex flex-col gap-2 p-6 h-full"
              href={c.href}
              {...(c.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <span class="font-mono text-xs uppercase text-muted">{c.title}</span>
              <span class="font-heading text-2xl font-extrabold tracking-tight break-all">{c.text}</span>
              <span class="text-muted">{c.note}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <Features2 title={copy.send.title} items={copy.send.items} />
</Layout>
