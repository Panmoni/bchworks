---
// The /onboard page, English or translated (PAN-386). The routes
// src/pages/onboard.astro and src/pages/[locale]/[page].astro pass the copy.
import Boxes from "~/components/widgets/Boxes.astro";
import CallToAction from "~/components/widgets/CallToAction.astro";
import FAQs from "~/components/widgets/FAQs.astro";
import Features from "~/components/widgets/Features.astro";
import Hero from "~/components/widgets/Hero.astro";
import InnerTitle from "~/components/widgets/InnerTitle.astro";
import Layout from "~/layouts/PageLayout.astro";
import type { TranslationState } from "~/utils/l10n";
import type { PageCopy } from "~/utils/pages";
import { getProjectsByCategory } from "~/utils/projects";

interface Props {
	/** The page copy for this locale (src/content/pages/[<locale>/]onboard). */
	copy: PageCopy;
	/** Set on a translated page: drives its <TranslationNotice>. */
	translation?: TranslationState | null;
}

const { copy, translation = null } = Astro.props;
const metadata = { ...copy.metadata, ignoreTitleTemplate: true };

const wallets = await getProjectsByCategory("wallet", Astro.currentLocale);
const hardwareWallets = await getProjectsByCategory(
	"wallet:hardware",
	Astro.currentLocale,
);

// Starter picks: links come from the shared project data; the "best for" copy lives in the page copy.
const bestFor: Record<string, string> = copy.starter.bestFor;
const starterWallets = Object.keys(bestFor)
	.map((title) => wallets.find((w) => w.title === title))
	.filter((w) => w !== undefined)
	.map((w) => ({
		...w,
		description: bestFor[w.title],
		descriptionFallback: false,
	}));
---

<Layout metadata={metadata} translation={translation}>
  <InnerTitle>
    <Fragment slot="title">{copy.hero.title}</Fragment>
    <Fragment slot="subtitle">{copy.hero.subtitle}</Fragment>
  </InnerTitle>

  <Features
    highlight=""
    title={copy.basics.title}
    subtitle={copy.basics.subtitle}
    items={copy.basics.items}
  />

  <Boxes
    title={copy.starter.title}
    subtitle={copy.starter.subtitle.replaceAll("{count}", () => String(starterWallets.length))}
    highlight=""
    items={starterWallets}
  />

  <Boxes
    title={copy.all.title}
    subtitle={copy.all.subtitle}
    highlight=""
    items={wallets}
  />

  <Boxes subtitle={copy.hardware.subtitle} items={hardwareWallets} />

  <FAQs
    title={copy.faq.title}
    subtitle={copy.faq.subtitle}
    highlight=""
    items={copy.faq.items}
  />

  <Hero>
    <Fragment slot="image">
      <div class="relative h-0 pb-[56.25%]">
        <iframe
          width="560"
          height="315"
          src="https://www.youtube.com/embed/arFDrjx_2JY"
          title={copy.video.title}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture;"
          allowfullscreen
          class="absolute top-0 left-0 w-full h-full"
        >
        </iframe>
      </div>
    </Fragment>
  </Hero>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: copy.cta.next,
        href: '/buy',
      },
      {
        text: copy.cta.updates,
        href: 'https://t.me/bchworks',
        target: '_blank',
      },
    ]}
  >
    <Fragment slot="title">{copy.cta.title}</Fragment>
    <Fragment slot="subtitle">{copy.cta.subtitle}</Fragment>
  </CallToAction>
</Layout>
