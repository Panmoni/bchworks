---
// The /glossary page, English or translated (PAN-387). The routes
// src/pages/glossary.astro and src/pages/[locale]/[page].astro pass the copy.
import { getCollection } from "astro:content";
import LocalizedText from "~/components/common/LocalizedText.astro";
import Freshness from "~/components/reference/Freshness.astro";
import InnerTitle from "~/components/widgets/InnerTitle.astro";
import { DEFAULT_LOCALE, getLocale, type LocaleCode } from "~/i18n/locales";
import Layout from "~/layouts/PageLayout.astro";
import {
	englishData,
	localizeRecord,
	type TranslationState,
} from "~/utils/l10n";
import type { PageCopy } from "~/utils/pages";

// Language of this page's JSON-LD: the route's locale (PAN-380).
const lang = getLocale(Astro.currentLocale).bcp47;

interface Props {
	/** The page copy for this locale (src/content/pages/[<locale>/]glossary). */
	copy: PageCopy;
	/** Set on a translated page: drives its <TranslationNotice>. */
	translation?: TranslationState | null;
}

const { copy, translation = null } = Astro.props;
const metadata = { ...copy.metadata, ignoreTitleTemplate: true };

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as LocaleCode;
const localePrefix = locale === DEFAULT_LOCALE ? "" : `/${locale}`;
const pageUrl = `https://bchworks.com${localePrefix}/glossary`;

// Each term and definition in this locale, English (marked) where the
// glossary overlay lacks it; sorted and lettered by the words shown.
const terms = (await getCollection("glossary"))
	.map((t) => ({
		...t,
		l10n: localizeRecord(
			{ id: t.id, term: t.data.term, definition: t.data.definition },
			"glossary",
			["term", "definition"],
			locale,
		),
	}))
	.sort((a, b) =>
		a.l10n.term.text.localeCompare(b.l10n.term.text, lang, {
			sensitivity: "base",
		}),
	);
const byId = new Map(terms.map((t) => [t.id, t]));
const initial = (t: (typeof terms)[number]) =>
	t.l10n.term.text[0].toLocaleUpperCase(lang);
const letters = [...new Set(terms.map(initial))];

const termSet = {
	"@context": "https://schema.org",
	"@type": "DefinedTermSet",
	inLanguage: lang,
	name: copy.termSetName,
	url: pageUrl,
	hasDefinedTerm: terms.map((t) => ({
		"@type": "DefinedTerm",
		name: t.l10n.term.text,
		alternateName: t.data.aka.length ? t.data.aka : undefined,
		description: t.l10n.definition.text,
		url: `${pageUrl}#${t.id}`,
	})),
};
---

<Layout metadata={metadata} translation={translation}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(termSet)} />
  </Fragment>

  <InnerTitle>
    <Fragment slot="title">{copy.hero.title}</Fragment>
    <Fragment slot="subtitle">{terms.length}{copy.hero.subtitle}</Fragment>
  </InnerTitle>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-8">
    <nav class="flex flex-wrap gap-2 mb-8" aria-label={copy.letterNav}>
      {letters.map((l) => <a class="wb-chip" href={`#letter-${l}`}>{l}</a>)}
    </nav>
    {
      letters.map((l) => (
        <section id={`letter-${l}`} class="scroll-mt-24 mb-8">
          <h2 class="font-heading text-3xl font-extrabold mb-3">{l}</h2>
          <dl class="space-y-4">
            {terms
              .filter((t) => initial(t) === l)
              .map((t) => (
                <div id={t.id} class="wb-card p-4 scroll-mt-24 target:shadow-hard target:bg-soft">
                  <dt class="font-heading text-xl font-extrabold">
                    <LocalizedText value={t.l10n.term} />
                    {t.data.aka.length > 0 && <span class="ml-2 font-sans text-sm font-normal text-muted">{copy.aka} <span {...englishData(locale)}>{t.data.aka.join(', ')}</span></span>}
                  </dt>
                  <dd class="mt-2">
                    <LocalizedText as="p" value={t.l10n.definition} />
                    <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm items-center">
                      {t.data.link && (
                        <a class="underline" href={t.data.link} {...(t.data.link.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                          {copy.learnMore}
                        </a>
                      )}
                      {t.data.related
                        .filter((r) => byId.has(r))
                        .map((r) => <a class="font-mono text-xs underline" href={`#${r}`}><LocalizedText value={byId.get(r)!.l10n.term} /></a>)}
                      <Freshness date={t.data.verified} />
                    </div>
                  </dd>
                </div>
              ))}
          </dl>
        </section>
      ))
    }
  </section>
</Layout>
