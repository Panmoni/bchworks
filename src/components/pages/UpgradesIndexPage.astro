---
// The /upgrades page, English or translated (PAN-387). The routes
// src/pages/upgrades/index.astro and src/pages/[locale]/[page].astro pass the copy.
import { getCollection } from "astro:content";
import Countdown from "~/components/reference/Countdown.astro";
import Freshness from "~/components/reference/Freshness.astro";
import InnerTitle from "~/components/widgets/InnerTitle.astro";
import { formatNumber } from "~/i18n/format";
import Layout from "~/layouts/PageLayout.astro";
import {
	englishData,
	listLocalized,
	type TranslationState,
} from "~/utils/l10n";
import type { PageCopy } from "~/utils/pages";
import { formatDate, getNextUpgrade } from "~/utils/reference";

interface Props {
	/** The page copy for this locale (src/content/pages/[<locale>/]upgrades-index). */
	copy: PageCopy;
	/** Set on a translated page: drives its <TranslationNotice>. */
	translation?: TranslationState | null;
}

const { copy, translation = null } = Astro.props;
const metadata = { ...copy.metadata, ignoreTitleTemplate: true };

const upgrades = await listLocalized(
	"upgrades",
	(await getCollection("upgrades")).sort(
		(a, b) => b.data.date.getTime() - a.data.date.getTime(),
	),
	Astro.currentLocale,
);
const next = await getNextUpgrade();
const statusStyle = {
	activated: "bg-wb-green",
	"locked-in": "bg-wb-yellow",
	proposed: "bg-wb-pink",
};
---

<Layout metadata={metadata} translation={translation}>
  <InnerTitle>
    <Fragment slot="title">{copy.hero.title}</Fragment>
    <Fragment slot="subtitle">{copy.hero.subtitle}</Fragment>
  </InnerTitle>

  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
    {next && <Countdown date={next.data.date} title={next.data.title} href={`/upgrades/${next.id}`} status={next.data.status} />}

    <ol class="relative border-l-4 border-line ml-3 mt-8 space-y-6">
      {
        upgrades.map(({ entry: u, data: t, fallback }) => (
          <li class="ml-6">
            <span aria-hidden="true" class:list={['absolute -left-[11px] w-4 h-4 rounded-full border-2 border-line', statusStyle[u.data.status]]} />
            <a href={`/upgrades/${u.id}`} class="wb-card wb-card-hover block p-5">
              <p class="font-mono text-xs text-muted">
                {formatDate(u.data.date, Astro.currentLocale)} · <span {...englishData(Astro.currentLocale)}>{u.data.status}</span>
                {u.data.height && copy.block.replaceAll('{height}', () => formatNumber(u.data.height as number, Astro.currentLocale))}
              </p>
              <h2 class="font-heading text-2xl font-extrabold tracking-tight mt-1" {...(fallback ? englishData(Astro.currentLocale) : {})}>{t.title}</h2>
              <p class="text-muted mt-2" {...(fallback ? englishData(Astro.currentLocale) : {})}>{t.summary}</p>
              <Freshness class="mt-3" date={u.data.verified} />
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</Layout>
