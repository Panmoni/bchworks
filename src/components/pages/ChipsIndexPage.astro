---
// The /chips page, English or translated (PAN-387). The routes
// src/pages/chips/index.astro and src/pages/[locale]/[page].astro pass the copy.
import { getCollection } from "astro:content";
import Freshness from "~/components/reference/Freshness.astro";
import InnerTitle from "~/components/widgets/InnerTitle.astro";
import { m, msg } from "~/i18n/messages";
import Layout from "~/layouts/PageLayout.astro";
import {
	englishData,
	listLocalized,
	type TranslationState,
} from "~/utils/l10n";
import type { PageCopy } from "~/utils/pages";

interface Props {
	/** The page copy for this locale (src/content/pages/[<locale>/]chips-index). */
	copy: PageCopy;
	/** Set on a translated page: drives its <TranslationNotice>. */
	translation?: TranslationState | null;
}

const { copy, translation = null } = Astro.props;
const metadata = { ...copy.metadata, ignoreTitleTemplate: true };
// Marks English words on a non-English page as a fallback fragment.
const en = englishData(Astro.currentLocale);

const order = [
	"proposed",
	"draft",
	"locked-in",
	"activated",
	"superseded",
	"withdrawn",
] as const;
const chips = await listLocalized(
	"chips",
	(await getCollection("chips")).sort((a, b) =>
		b.data.code.localeCompare(a.data.code),
	),
	Astro.currentLocale,
);
const byStatus = order
	.map((s) => ({
		status: s,
		items: chips.filter((c) => c.entry.data.status === s),
	}))
	.filter((g) => g.items.length);
const l = msg(Astro.currentLocale);
// A CHIP with no number has the code "CHIP (unnumbered, <year>)" in its
// frontmatter; the words around the year are the reader's language.
const chipCode = (code: string) => {
	const year = code.match(/^CHIP \(unnumbered, (\d{4})\)$/)?.[1];
	return year ? m.chips_code_unnumbered({ year }, l) : code;
};
---

<Layout metadata={metadata} translation={translation}>
  <InnerTitle>
    <Fragment slot="title">{copy.hero.title}</Fragment>
    <Fragment slot="subtitle">{copy.hero.subtitle}</Fragment>
  </InnerTitle>

  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-8">
    <p class="text-lg text-muted mb-8">
      <Fragment set:html={copy.intro} />
    </p>
    {
      byStatus.map((g) => (
        <section class="mb-10">
          <h2 class="font-heading text-2xl font-extrabold tracking-tight mb-3 capitalize" {...en}>{g.status}</h2>
          <ul class="grid gap-3 md:grid-cols-2">
            {g.items.map((i) => (
              <li>
                <a class="wb-card wb-card-hover block p-4 h-full" href={`/chips/${i.entry.id}`}>
                  <span class="font-mono text-xs text-muted">{chipCode(i.entry.data.code)}</span>
                  <span class="block font-heading text-lg font-extrabold" {...i.attrs}>{i.data.title}</span>
                  <span class="block text-sm text-muted mt-1" {...i.attrs}>{i.data.summary}</span>
                  <Freshness class="mt-2" date={i.entry.data.verified} />
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </section>
</Layout>
