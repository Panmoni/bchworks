---
// The /compare page, English or translated (PAN-387). The routes
// src/pages/compare/index.astro and src/pages/[locale]/[page].astro pass the copy.
import { getCollection } from "astro:content";
import RealNumbers from "~/components/reference/RealNumbers.astro";
import InnerTitle from "~/components/widgets/InnerTitle.astro";
import Layout from "~/layouts/PageLayout.astro";
import {
	englishData,
	listLocalized,
	type TranslationState,
} from "~/utils/l10n";
import type { PageCopy } from "~/utils/pages";

interface Props {
	/** The page copy for this locale (src/content/pages/[<locale>/]compare-index). */
	copy: PageCopy;
	/** Set on a translated page: drives its <TranslationNotice>. */
	translation?: TranslationState | null;
}

const { copy, translation = null } = Astro.props;
const metadata = { ...copy.metadata, ignoreTitleTemplate: true };

const pages = await listLocalized(
	"compare",
	(await getCollection("compare")).sort((a, b) =>
		a.data.rival.localeCompare(b.data.rival),
	),
	Astro.currentLocale,
);
---

<Layout metadata={metadata} translation={translation}>
  <InnerTitle>
    <Fragment slot="title">{copy.hero.title}</Fragment>
    <Fragment slot="subtitle">{copy.hero.subtitle}</Fragment>
  </InnerTitle>
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-8">
    <RealNumbers compare={['btc', 'ltc', 'eth', 'sol', 'kas', 'ada']} />
    <ul class="grid gap-4 sm:grid-cols-2 mt-8">
      {
        pages.map((i) => (
          <li>
            <a class="wb-card wb-card-hover block p-5 h-full" href={`/compare/${i.entry.id}`}>
              <span class="font-mono text-xs text-muted">{copy.card.replaceAll('{ticker}', () => i.entry.data.ticker)}</span>
              <span class="block font-heading text-xl font-extrabold mt-1" {...(i.fallback ? englishData(Astro.currentLocale) : {})}>{i.data.title}</span>
              <span class="block text-sm text-muted mt-2" {...(i.fallback ? englishData(Astro.currentLocale) : {})}>{i.data.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
