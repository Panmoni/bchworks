---
// The /wallet page, English or translated (PAN-386). The routes
// src/pages/wallet.astro and src/pages/[locale]/[page].astro pass the copy.
import { getCollection } from "astro:content";
import Freshness from "~/components/reference/Freshness.astro";
import HealthBadge from "~/components/reference/HealthBadge.astro";
import InnerTitle from "~/components/widgets/InnerTitle.astro";
import { getLocale } from "~/i18n/locales";
import Layout from "~/layouts/PageLayout.astro";
import { englishData, type TranslationState } from "~/utils/l10n";
import type { CopyList, PageCopy } from "~/utils/pages";
import {
	faqJsonLd,
	formatDate,
	getHealthMap,
	isoDate,
} from "~/utils/reference";

// Language of this page's JSON-LD: the route's locale (PAN-380).
const lang = getLocale(Astro.currentLocale).bcp47;

interface Props {
	/** The page copy for this locale (src/content/pages/[<locale>/]wallet). */
	copy: PageCopy;
	/** Set on a translated page: drives its <TranslationNotice>. */
	translation?: TranslationState | null;
}

const { copy, translation = null } = Astro.props;
const metadata = { ...copy.metadata, ignoreTitleTemplate: true };

const health = await getHealthMap();
const wallets = (await getCollection("projects"))
	.filter((p) => p.data.wallet && p.data.status !== "deprecated")
	.map((p) => ({ ...p, h: health.get(p.id) }))
	// CashTokens depth first, then most recently released.
	.sort((a, b) => {
		const rank = { full: 0, partial: 1, none: 2 };
		return (
			rank[a.data.wallet!.cashtokens] - rank[b.data.wallet!.cashtokens] ||
			(b.h?.lastRelease?.getTime() ?? 0) - (a.h?.lastRelease?.getTime() ?? 0) ||
			a.data.title.localeCompare(b.data.title)
		);
	});

const yes = (v: boolean) => (v ? "✓" : "—");
const platformLabel: Record<string, string> = copy.table.platformLabels;

const faq: Array<{ q: string; a: string }> = copy.faq.items;

// One section per platform (PAN-422), listing the table's wallets for it.
const platforms = (copy.platforms as CopyList).map((p) => ({
	id: p.id as string,
	title: p.title as string,
	text: p.text as string,
	wallets: wallets.filter((w) => w.data.wallet!.platforms.includes(p.id)),
}));
const updateDate = new Date(copy.updateDate);

const faqLd = faqJsonLd(faq, lang);
---

<Layout metadata={metadata} translation={translation}>
  <Fragment slot="head">
    {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
  </Fragment>

  <InnerTitle>
    <Fragment slot="title">{copy.hero.title}</Fragment>
    <Fragment slot="subtitle">{copy.hero.subtitle.replaceAll("{count}", () => String(wallets.length))}</Fragment>
  </InnerTitle>
  <p class="text-center font-mono text-xs text-muted -mt-4">
    {copy.updated} <time datetime={isoDate(updateDate)}>{formatDate(updateDate, Astro.currentLocale)}</time>
  </p>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    <div class="grid md:grid-cols-3 gap-4 mb-8">
      {
        copy.tips.map(({ label, text }: { label: string; text: string }) => (
          <div class="wb-card p-5">
            <p class="font-mono text-xs uppercase text-muted">{label}</p>
            <p class="mt-1" set:html={text} />
          </div>
        ))
      }
    </div>

    <div class="wb-card overflow-x-auto">
      <table class="w-full min-w-[900px] text-sm">
        <thead class="text-left font-mono text-xs text-muted bg-soft">
          <tr>
            <th class="p-3">{copy.table.wallet}</th>
            <th class="p-3">{copy.table.platforms}</th>
            <th class="p-3">{copy.table.custody}</th>
            <th class="p-3">{copy.table.cashtokens}</th>
            <th class="p-3 text-center">{copy.table.walletconnect}</th>
            <th class="p-3 text-center">{copy.table.openSource}</th>
            <th class="p-3">{copy.table.lastRelease}</th>
            <th class="p-3">{copy.table.status}</th>
          </tr>
        </thead>
        <tbody>
          {
            wallets.map((w) => {
              const f = w.data.wallet!;
              return (
                <tr class="border-t-2 border-line/20 align-top">
                  <td class="p-3">
                    <div class="flex items-center gap-2">
                      {w.data.icon && (
                        <img src={w.data.icon} alt="" loading="lazy" class="w-7 h-7 rounded border-2 border-line bg-white object-contain p-0.5" />
                      )}
                      <a class="font-bold hover:underline" href={w.data.url} target="_blank" rel="noopener noreferrer">
                        {w.data.title}
                      </a>
                    </div>
                    {f.notes && <p class="text-xs text-muted mt-1 max-w-[28ch]" {...englishData(Astro.currentLocale)}>{f.notes}</p>}
                    <Freshness class="mt-1" date={w.data.verified} />
                  </td>
                  <td class="p-3">{f.platforms.map((p) => platformLabel[p]).join(', ')}</td>
                  <td class="p-3">{copy.table.custodyLabels[f.custody]}</td>
                  <td class="p-3">{copy.table.cashtokensLabels[f.cashtokens]}</td>
                  <td class="p-3 text-center">{yes(f.walletconnect)}</td>
                  <td class="p-3 text-center">
                    {f.openSource && w.data.github ? (
                      <a class="underline" href={`https://github.com/${w.data.github}`} target="_blank" rel="noopener noreferrer">✓</a>
                    ) : (
                      yes(f.openSource)
                    )}
                  </td>
                  <td class="p-3 font-mono text-xs">{w.h?.lastRelease ? formatDate(w.h.lastRelease, Astro.currentLocale) : copy.table.noRelease}</td>
                  <td class="p-3"><HealthBadge health={w.h} /></td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-sm text-muted" set:html={copy.table.note} />
  </section>

  {
    platforms.map((p) => (
      <section id={p.id} class="max-w-7xl mx-auto px-4 sm:px-6 py-6 scroll-mt-24">
        <h2 class="font-heading text-3xl font-extrabold tracking-tight mb-2">{p.title}</h2>
        <p class="max-w-3xl text-muted mb-4">{p.text}</p>
        <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {
            p.wallets.map((w) => (
              <li class="wb-card p-3 flex items-center gap-3">
                {w.data.icon && (
                  <img src={w.data.icon} alt="" loading="lazy" class="w-7 h-7 rounded border-2 border-line bg-white object-contain p-0.5" />
                )}
                <div>
                  <a class="font-bold hover:underline" href={w.data.url} target="_blank" rel="noopener noreferrer">
                    {w.data.title}
                  </a>
                  <p class="text-xs text-muted">
                    {copy.table.custodyLabels[w.data.wallet!.custody]} · {copy.table.cashtokens}:{' '}
                    {copy.table.cashtokensLabels[w.data.wallet!.cashtokens]}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </section>
    ))
  }

  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-8">
    <h2 class="font-heading text-3xl font-extrabold tracking-tight mb-4">{copy.faq.title}</h2>
    <div class="space-y-3">
      {
        faq.map(({ q, a }) => (
          <details class="wb-card p-4">
            <summary class="font-bold cursor-pointer">{q}</summary>
            <p class="mt-2 text-muted">{a}</p>
          </details>
        ))
      }
    </div>
    <p class="mt-6 text-muted" set:html={copy.builders} />
  </section>
</Layout>
