---
// Previous/next links between the parts of a tutorial series (PAN-423).
// Renders nothing on a post outside a series. Titles come from the post in
// the reader's locale, else from the English post.
import { m, msg } from "~/i18n/messages";
import type { Post } from "~/types";
import { fetchLocalizedPosts, fetchPosts } from "~/utils/blog";
import { getPermalink } from "~/utils/permalinks";

export interface Props {
	slug: string;
}

// Each series in reading order, by post slug.
const SERIES = [
	[
		"token-pioneers-cashtokens-tutorial-1",
		"token-pioneers-cashtokens-tutorial-2",
		"token-pioneers-cashtokens-tutorial-3",
		"token-pioneers-cashtokens-tutorial-4",
	],
];

const { slug } = Astro.props;
const l = msg(Astro.currentLocale);

const series = SERIES.find((s) => s.includes(slug));
const index = series?.indexOf(slug) ?? -1;

const [localized, english] = series
	? await Promise.all([fetchLocalizedPosts(Astro.currentLocale), fetchPosts()])
	: [[], []];
const find = (s: string): Post | undefined =>
	localized.find((p) => p.slug === s) ?? english.find((p) => p.slug === s);

const link = (i: number) => {
	const post = series && i >= 0 ? find(series[i] ?? "") : undefined;
	return post
		? {
				part: i + 1,
				title: post.title,
				href: getPermalink(post.permalink, "post"),
			}
		: undefined;
};
const prev = series ? link(index - 1) : undefined;
const next = series ? link(index + 1) : undefined;
---

{
  (prev || next) && (
    <nav aria-label={m.blog_series_label({}, l)} class="not-prose mt-12 grid gap-4 sm:grid-cols-2">
      {prev && (
        <a href={prev.href} rel="prev" class="wb-card p-5 hover:bg-soft">
          <span class="block font-mono text-xs uppercase text-muted">{m.blog_series_previous({ part: prev.part }, l)}</span>
          <span class="mt-1 block font-bold">{prev.title}</span>
        </a>
      )}
      {next && (
        <a href={next.href} rel="next" class="wb-card p-5 hover:bg-soft sm:col-start-2 sm:text-right">
          <span class="block font-mono text-xs uppercase text-muted">{m.blog_series_next({ part: next.part }, l)}</span>
          <span class="mt-1 block font-bold">{next.title}</span>
        </a>
      )}
    </nav>
  )
}
